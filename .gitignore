# Agent System - Git Ignore

# Temporary and intermediate files
.tmp/
*.tmp
*.temp

# Environment variables and secrets
.env
.env.local
.env.*.local

# Google OAuth credentials
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Node modules (if using Node.js tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Data backups (keep only db.json in version control)
data/*.backup
data/*.bak

# Test outputs
test-results/
coverage/
